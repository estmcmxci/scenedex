flowchart TD
    Start([Contributor Access Request]) --> NotifyBoard["Notify Board Members<br/>of New Request"]
    NotifyBoard --> BDashboard["Board Dashboard<br/>Shows Pending Requests"]
    
    BDashboard --> ReviewReq["Board Member Reviews<br/>Contributor Profile"]
    ReviewReq --> CheckDetails["Check Details:<br/>Wallet, Background, Intent"]
    
    CheckDetails --> Discussion["Discussion Among<br/>Board Members"]
    Discussion --> Vote["Vote on Approval"]
    
    Vote --> VoteCheck{Consensus<br/>Reached?}
    VoteCheck -->|Rejected| Denied["Request Denied<br/>Contributor Notified"]
    VoteCheck -->|Approved| MintNFT["Mint Soulbound NFT<br/>to Contributor Wallet"]
    
    Denied --> End1([End])
    
    MintNFT --> NFTMetadata["NFT Metadata:<br/>- Contributor Status: TRUE<br/>- Upload Limit: 6 releases<br/>- Issued Date<br/>- Board Signature"]
    
    NFTMetadata --> TransferNFT["Transfer Soul-bound NFT<br/>to Contributor Address"]
    TransferNFT --> Lock["Lock NFT to Wallet<br/>Non-Transferable"]
    
    Lock --> UpdateChain["Update Blockchain State:<br/>Contributor Verified"]
    UpdateChain --> PermissionGrant["Grant Upload Permissions<br/>with Limit Counter"]
    
    PermissionGrant --> Approved["Contributor Activated<br/>Ready to Publish"]
    Approved --> Tracking["System Tracks:<br/>Releases Published: 0/6"]
    
    Tracking --> End2([Contributor Can Now Upload])
    
    style Start fill:#39FF14,stroke:#00FF00,color:#000
    style NotifyBoard fill:#00D9FF,stroke:#00FFFF,color:#000
    style Vote fill:#FFFF00,stroke:#FFD700,color:#000
    style MintNFT fill:#D946EF,stroke:#9D4EDD,color:#fff
    style NFTMetadata fill:#D946EF,stroke:#9D4EDD,color:#fff
    style Lock fill:#D946EF,stroke:#9D4EDD,color:#fff
    style PermissionGrant fill:#00D9FF,stroke:#00FFFF,color:#000
    style Approved fill:#39FF14,stroke:#00FF00,color:#000
    style Denied fill:#FF1744,stroke:#FF0000,color:#fff

