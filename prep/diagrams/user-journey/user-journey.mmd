flowchart TB
    subgraph Contributor["👤 Contributor Flow"]
        A([Visit palaupalau.eth.link]) --> B["Connect Wallet"]
        B --> C["Request Contributor Access"]
        C --> D["Submit to Curator Board"]
    end
    
    subgraph Approval["🏛️ Board Review & Approval"]
        D --> E["Board Reviews Request"]
        E --> F{Contributor<br/>Approved?}
        F -->|Rejected| G["Access Denied"]
        F -->|Approved| H["Grant Contributor Status<br/>Add to Allowlist"]
    end
    
    subgraph SubmitMedia["📤 Media & Metadata Submission"]
        H --> I[Ready to Publish]
        I --> J["Upload Metadata<br/>Title, Description, Tags"]
        J --> K["Upload Media Files<br/>Audio, Video, Image"]
        K --> L{Metadata<br/>Complete?}
        L -->|No| J
        L -->|Yes| M["Package Release Data"]
    end
    
    subgraph IPFSStorage["🗄️ IPFS Storage<br/>Autark CLI / Storacha"]
        M --> N["Store Metadata on IPFS"]
        N --> O["Retrieve IPFS Hash<br/>ipfs://Qm..."]
    end
    
    subgraph BaseL2["⛓️ Base L2 - NFT Minting<br/>Zora Creator Contract"]
        O --> P["Mint NFT on Base"]
        P --> Q{NFT Mint<br/>Success?}
        Q -->|Failed| R["Retry Upload"]
        Q -->|Success| S["Capture Zora Token ID<br/>+ Metadata URI"]
    end
    
    subgraph L1ENS["⛓️ Ethereum L1 - ENS Registry<br/>Factory Contract"]
        S --> T["Call Factory Contract"]
        T --> U["Mint ENS Subname<br/>pda-XXX.palaupalau.eth"]
        U --> V["Link Subname to Base NFT<br/>via ENS Resolver/Contenthash"]
        V --> W["Emit ReleaseAdded Event"]
    end
    
    subgraph Indexing["🔍 Event Indexing & Data Layer<br/>The Graph / Reservoir"]
        W --> X["Capture ReleaseAdded Event"]
        X --> Y["Index Release Data<br/>ENS + Base NFT + IPFS"]
        Y --> Z["Make Data Queryable<br/>via GraphQL API"]
    end
    
    subgraph Frontend["🎨 Frontend & Display<br/>Next.js"]
        Z --> AA["Frontend Queries ENS + Zora + IPFS"]
        AA --> AB["Resolve ENS Subname<br/>to Base NFT ID"]
        AB --> AC["Fetch NFT Metadata<br/>from IPFS"]
        AC --> AD["Render Catalog Entry<br/>Display Release"]
        AD --> AE([Release Live on Catalog])
    end
    
    AE --> AF{Publish<br/>Another?}
    AF -->|Yes| J
    AF -->|No| AG([Complete])
    
    G --> AG
    R --> M
    
    style A fill:#39FF14,stroke:#00FF00,color:#000
    style AE fill:#39FF14,stroke:#00FF00,color:#000
    style F fill:#FFFF00,stroke:#FFD700,color:#000
    style L fill:#FFFF00,stroke:#FFD700,color:#000
    style Q fill:#FFFF00,stroke:#FFD700,color:#000
    style P fill:#D946EF,stroke:#9D4EDD,color:#fff
    style U fill:#D946EF,stroke:#9D4EDD,color:#fff
    style N fill:#00D9FF,stroke:#00FFFF,color:#000
    style W fill:#FF1744,stroke:#FF0000,color:#fff
    style X fill:#FF1744,stroke:#FF0000,color:#fff
