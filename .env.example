# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# Blockchain RPC Endpoints
# ============================================================================
BASE_RPC_URL=https://sepolia.base.org

# ============================================================================
# Wallet & Signing
# ============================================================================
# Private key for curator coordinator (used for Safe transactions, ENS registration)
# This key should derive to an address that is a Safe owner
CURATOR_PRIVATE_KEY=0x...

# Optional: Explicit curator address (if different from derived address)
# CURATOR_ADDRESS=0x...

# ============================================================================
# Safe Multisig Configuration
# ============================================================================
# Safe multisig address (curator governance)
SAFE_ADDRESS=0x...
# Alternative: CURATOR_SAFE_ADDRESS (used as fallback)

# Optional: Safe API key for Safe transaction service
# SAFE_API_KEY=your-safe-api-key

# ============================================================================
# ENS Configuration
# ============================================================================
# Parent ENS domain (e.g., scenedex.eth, scenius.basetest.eth)
ENS_DOMAIN=scenius.basetest.eth

# Optional: ENS parent node hash (auto-calculated if not provided)
# ENS_PARENT_NODE=0x...

# Subname prefix for releases (e.g., ARES, SOMA, EROS)
ENS_SUBNAME_PREFIX=ARES

# Starting number for sequential release IDs
ENS_START_NUMBER=1

# Service namespace for ENS text records
ENS_SERVICE_NAMESPACE=eth.scenedex

# ENS Contract Addresses (Base Sepolia)
# Resolver contract address
ENS_RESOLVER_BASE_SEPOLIA=0x...
# Alternative: BASENAMES_UPGRADEABLE_RESOLVER_BASE_SEPOLIA

# Controller contract address
BASENAMES_UPGRADEABLE_CONTROLLER_BASE_SEPOLIA=0x...

# Reverse registrar contract address
BASENAMES_REVERSE_REGISTRAR_BASE_SEPOLIA=0x...

# Base registrar contract address
BASENAMES_BASE_REGISTRAR_BASE_SEPOLIA=0x...

# ENS NameWrapper (Sepolia L1 - if using L1 ENS)
ENS_NAMEWRAPPER_SEPOLIA=0x0635513f179D50A207757E05759CbD106d7dFcE8

# Legacy ENS resolver (Sepolia L1)
ENS_RESOLVER_SEPOLIA=0x...

# ============================================================================
# Zora Configuration
# ============================================================================
# Zora Coin Factory contract address (Base Sepolia)
ZORA_COIN_FACTORY_ADDRESS=0x777777751622c0d3258f214F9DF38E35BF45baF3

# ============================================================================
# Frontend / Public Variables
# ============================================================================
# WalletConnect project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Optional: Base RPC URL for frontend
# NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org

# ============================================================================
# Testing (Optional)
# ============================================================================
# TEST_ARTIST_ADDRESS=0x...
# PRIVATE_KEY=0x... (for testing scripts)
